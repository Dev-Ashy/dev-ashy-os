#!/bin/bash
# Dev-Ashy OS ISO Builder
# Usage: ./build-iso [options]

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
BUILD_DIR="$PROJECT_DIR/build"
ISO_DIR="$PROJECT_DIR/iso"
LOG_DIR="$BUILD_DIR/logs"
CONFIG_DIR="$PROJECT_DIR/config"
BRANDING_DIR="$PROJECT_DIR/branding"
PACKAGES_DIR="$PROJECT_DIR/packages"

VERSION="0.1.0"
ISO_NAME="Dev-Ashy-OS-${VERSION}-amd64.iso"
TIMESTAMP=$(date -u '+%Y%m%d_%H%M%S')
LOG_FILE="$LOG_DIR/${TIMESTAMP}.log"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log() {
    echo -e "${BLUE}[$(date -u '+%H:%M:%S')]${NC} $1" | tee -a "$LOG_FILE"
}

error() {
    echo -e "${RED}[ERROR]${NC} $1" | tee -a "$LOG_FILE"
    exit 1
}

success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1" | tee -a "$LOG_FILE"
}

warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1" | tee -a "$LOG_FILE"
}

# Create directories
mkdir -p "$BUILD_DIR" "$ISO_DIR" "$LOG_DIR"

log "Starting Dev-Ashy OS ISO build v${VERSION}"
log "Build timestamp: $TIMESTAMP"
log "Log file: $LOG_FILE"

# Check dependencies
log "Checking dependencies..."

MISSING_DEPS=()

command -v cubic >/dev/null 2>&1 || MISSING_DEPS+=("cubic")
command -v genisoimage >/dev/null 2>&1 || MISSING_DEPS+=("genisoimage")
command -v xorriso >/dev/null 2>&1 || MISSING_DEPS+=("xorriso")
command -v mksquashfs >/dev/null 2>&1 || MISSING_DEPS+=("squashfs-tools")
command -v curl >/dev/null 2>&1 || MISSING_DEPS+=("curl")

if [ ${#MISSING_DEPS[@]} -ne 0 ]; then
    error "Missing dependencies: ${MISSING_DEPS[*]}\nInstall with: sudo apt-get install ${MISSING_DEPS[*]}"
fi

success "All dependencies found"

# Check for Ubuntu base ISO
UBUNTU_ISO="$BUILD_DIR/ubuntu-24.04-desktop-amd64.iso"
if [ ! -f "$UBUNTU_ISO" ]; then
    warning "Ubuntu base ISO not found, downloading..."
    log "Downloading Ubuntu 24.04 Desktop AMD64..."
    curl -L -o "$UBUNTU_ISO" "https://releases.ubuntu.com/24.04/ubuntu-24.04.1-desktop-amd64.iso" 2>&1 | tee -a "$LOG_FILE"
    success "Ubuntu ISO downloaded"
fi

# Create working directory
WORK_DIR="$BUILD_DIR/work"
rm -rf "$WORK_DIR"
mkdir -p "$WORK_DIR"

# Extract ISO
log "Extracting Ubuntu ISO..."
xorriso -osirrox on -indev "$UBUNTU_ISO" -extract / "$WORK_DIR" 2>&1 | tee -a "$LOG_FILE"
success "ISO extracted"

# Apply Dev-Ashy branding
log "Applying Dev-Ashy branding..."

# Copy branding assets
cp -r "$BRANDING_DIR"/* "$WORK_DIR/" 2>/dev/null || true

# Apply wallpaper
if [ -f "$BRANDING_DIR/wallpaper.png" ]; then
    mkdir -p "$WORK_DIR/usr/share/backgrounds"
    cp "$BRANDING_DIR/wallpaper.png" "$WORK_DIR/usr/share/backgrounds/dev-ashy-wallpaper.png"
    success "Wallpaper applied"
fi

# Apply theme
if [ -d "$BRANDING_DIR/theme" ]; then
    cp -r "$BRANDING_DIR/theme" "$WORK_DIR/usr/share/themes/Dev-Ashy"
    success "Theme applied"
fi

# Customize packages
log "Customizing package list..."
if [ -f "$PACKAGES_DIR/package-list.txt" ]; then
    cp "$PACKAGES_DIR/package-list.txt" "$WORK_DIR/package-list.txt"
    success "Package list applied"
fi

# Add Dev-Ashy scripts
log "Adding Dev-Ashy scripts..."
mkdir -p "$WORK_DIR/usr/bin"
cp "$PROJECT_DIR/scripts/"* "$WORK_DIR/usr/bin/" 2>/dev/null || true
chmod +x "$WORK_DIR/usr/bin/"* 2>/dev/null || true

# Add first-boot script
log "Adding first-boot experience..."
mkdir -p "$WORK_DIR/etc/skel"
cp "$PROJECT_DIR/scripts/dev-ashy-setup" "$WORK_DIR/etc/skel/.dev-ashy-setup"
chmod +x "$WORK_DIR/etc/skel/.dev-ashy-setup"

# Create filesystem manifest
log "Creating filesystem manifest..."
find "$WORK_DIR" -type f | sort > "$WORK_DIR/filesystem.manifest"

# Build SquashFS
log "Building SquashFS filesystem..."
mksquashfs "$WORK_DIR" "$BUILD_DIR/filesystem.squashfs" -comp xz -b 1M -noappend 2>&1 | tee -a "$LOG_FILE"
success "SquashFS created"

# Build ISO
log "Building ISO..."
mkdir -p "$ISO_DIR"

grub-mkrescue -o "$ISO_DIR/$ISO_NAME" "$WORK_DIR" \
    --modules="part_gpt part_msdos fat iso9660 zfs zfscrypt zfsinfo lvm luks gcry_rijndael gcry_sha256 gcry_sha512 gcry_dsa gcry_rsa" \
    2>&1 | tee -a "$LOG_FILE" || {
    # Fallback to genisoimage
    warning "grub-mkrescue failed, trying genisoimage..."
    genisoimage -o "$ISO_DIR/$ISO_NAME" \
        -b isolinux/isolinux.bin \
        -c isolinux/boot.cat \
        -no-emul-boot \
        -boot-load-size 4 \
        -boot-info-table \
        -J -R -V "Dev-Ashy OS" \
        "$WORK_DIR" 2>&1 | tee -a "$LOG_FILE"
}

success "ISO built: $ISO_DIR/$ISO_NAME"

# Generate checksums
log "Generating checksums..."
cd "$ISO_DIR"
sha256sum "$ISO_NAME" > SHA256SUMS
success "Checksums generated: SHA256SUMS"

# Generate software manifest
log "Generating software manifest..."
if [ -f "$PACKAGES_DIR/package-list.txt" ]; then
    echo "# Dev-Ashy OS Software Manifest" > "$ISO_DIR/ISO-SOFTWARE-MANIFEST.txt"
    echo "# Version: $VERSION" >> "$ISO_DIR/ISO-SOFTWARE-MANIFEST.txt"
    echo "# Date: $(date -u '+%Y-%m-%d %H:%M:%S UTC')" >> "$ISO_DIR/ISO-SOFTWARE-MANIFEST.txt"
    echo "" >> "$ISO_DIR/ISO-SOFTWARE-MANIFEST.txt"
    echo "## Base System" >> "$ISO_DIR/ISO-SOFTWARE-MANIFEST.txt"
    echo "Ubuntu 24.04 LTS" >> "$ISO_DIR/ISO-SOFTWARE-MANIFEST.txt"
    echo "" >> "$ISO_DIR/ISO-SOFTWARE-MANIFEST.txt"
    echo "## Packages" >> "$ISO_DIR/ISO-SOFTWARE-MANIFEST.txt"
    cat "$PACKAGES_DIR/package-list.txt" >> "$ISO_DIR/ISO-SOFTWARE-MANIFEST.txt"
    success "Software manifest generated"
fi

# Cleanup
log "Cleaning up..."
rm -rf "$WORK_DIR"

# Final report
ISO_SIZE=$(du -h "$ISO_DIR/$ISO_NAME" | cut -f1)
log ""
log "========================================"
log "  Dev-Ashy OS ISO Build Complete"
log "========================================"
log "  Version:    $VERSION"
log "  ISO:        $ISO_NAME"
log "  Size:       $ISO_SIZE"
log "  Location:   $ISO_DIR"
log "  Checksum:   $ISO_DIR/SHA256SUMS"
log "========================================"
log ""
log "Next steps:"
log "  1. Test the ISO: ./test-iso $ISO_DIR/$ISO_NAME"
log "  2. Verify: ./verify-iso $ISO_DIR/$ISO_NAME"
log "  3. Release: ./release-iso $VERSION"
log ""

success "Build complete!"
